{% import "_macros.j2" as m %}
{{ m.system_prompt(system_prompt) }}
{{ m.conversation(conversation) }}
{% if input %}{{ m.untrusted("task", input) }}{% endif %}
<trajectory>
{% for s in trajectory %}
Step {{ loop.index }}:
{% if s.thought %}  thought: {{ s.thought }}
{% endif %}
{% if s.tool %}  tool: {{ s.tool }}({{ s.tool_input | tojson }})
{% endif %}
{% if s.observation %}  observation: {{ s.observation }}
{% endif %}
{% endfor %}
</trajectory>
{{ m.untrusted("final_answer", output) }}
{{ m.security_note() }}
{{ m.prior_verdicts(priors) }}
